# High-strength configuration. Runtime integrity and Gson schema pinning require
# explicit application selectors and are intentionally configured per target.

defaults {
  exempt = [ "class{^dev/murk/mixin/}" ]
  naming {
    chars: [ "I", "l1", "lI", "1l" ]
    depth: 8
  }
}

sourceStrip { enabled: true, stripLineNumbers: true, stripLocalVars: true, stripSignatures: true }
semanticCore { enabled: true, percent: 45, minOperations: 3, maxMethods: 64 }
semanticFabric { enabled: true, percent: 100, minArithmeticOps: 3, maxMethods: 96, carriers: 12 }

stringEncryption { enabled: true, type: POLYMORPHIC }
numberEncryption { enabled: true, layers: 5 }

safeControlFlow { enabled: false, level: 3 }
mangledJump { enabled: false }
flowSwitch { enabled: true }
integerReturn { enabled: true }
exceptionReturn { enabled: true, percent: 100 }

antiAI { enabled: true, level: 3, decoyMethods: 8, constantEncodingPercent: 85 }
antiDecompiler { enabled: true, level: 3 }
antiDeobf { enabled: true, level: 3, badSignatures: false, badRealClassSignatures: false }
fileCrasher { enabled: true }

classRenamer { enabled: true, renameMain: true, prefix: "a/" }
methodRenamer { enabled: true, renameVirtual: true, renamePublic: true }
fieldRenamer { enabled: true }

crossClassDispersion { enabled: true, dispersalPercent: 75, sinks: 24, variantsPerOpcode: 2, maxHelpers: 2048, maxOperations: 8192 }
recordMetadata { enabled: true, eraseIdentity: true }
methodRelocation { enabled: true, percent: 85, maxMethods: 128, carriers: 16, minInstructions: 20 }
methodExtraction { enabled: true, percent: 100, maxMethods: 160, carriers: 16, minInstructions: 8 }
fieldPacking { enabled: true, minFields: 1 }

referenceHiding { enabled: true, hidePercent: 100 }

antiDebug { enabled: true, checkPercent: 50, detectors: 6 }

flatten { enabled: true, percent: 100, allowReferenceLocals: false }

fieldIndirection { enabled: true, percent: 100 }
